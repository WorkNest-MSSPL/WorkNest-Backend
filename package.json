{
  "name": "worknest-api",
  "version": "1.0.0",
  "description": "License-controlled API boilerplate (no external libs)",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "prep": "node lc.obf.js",
    "start": "node dist/bundle.js",
    "dev": "nodemon src/index.js",
    "swagger": "node generate-swagger.js",
    "build": "esbuild src/index.js --bundle --platform=node --outfile=dist/bundle.js",
    "generate-license": "node license-generator.js",
    "obfuscate": "npx javascript-obfuscator checker.js --output checker.obf.js --compact true --self-defending true --control-flow-flattening true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.9",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^7.0.6",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.10"
  }
}
